{
  "id": "dag_sop_15_capital_matching",
  "name": "SOP-15: Quy trình Thẩm định Hồ sơ Tín dụng & Kết nối Nguồn vốn Đa dạng",
  "description": "Trích xuất thu chi từ hệ thống clone của thành viên, tổng hợp và hiển thị công khai lên bảng gọi vốn ẩn danh.",
  "status": "ACTIVE",
  "trigger": {
    "type": "CRON",
    "expression": "0 0 * * 0"
  },
  "nodes": [
    {
      "id": "node_1_extract_data",
      "command": "financial_extract_member_data",
      "input": {
        "member_id": "{{member_id}}",
        "project_name": "{{project_name}}"
      },
      "next": "node_2_consolidate"
    },
    {
      "id": "node_2_consolidate",
      "command": "financial_consolidate_report",
      "input": {
        "member_id": "{{member_id}}",
        "project_name": "{{project_name}}",
        "income": "{{nodes.node_1_extract_data.output.income}}",
        "expense": "{{nodes.node_1_extract_data.output.expense}}",
        "net_profit": "{{nodes.node_1_extract_data.output.net_profit}}"
      },
      "next": "node_3_publish"
    },
    {
      "id": "node_3_publish",
      "command": "financial_publish_dashboard",
      "input": {
        "member_id": "{{member_id}}",
        "project_name": "{{project_name}}"
      }
    }
  ]
}
