{
  "id": "dag_sop_13_contribution_poll",
  "name": "SOP-13: Quy trình Đánh giá & Bỏ phiếu Khen thưởng Đồng đội (Quỹ 20%)",
  "description": "Chatbot tự động thống kê chỉ số hỗ trợ, mở cổng Bỏ phiếu kín toàn Cộng đồng vào cuối tuần và giải ngân 20% Quỹ thưởng",
  "nodes": [
    {
      "id": "node_1_aggregate_contributions",
      "command": "tracker_aggregate_contributions",
      "input": {
        "month": "2026-08"
      }
    },
    {
      "id": "node_2_open_blind_vote",
      "command": "poll_open_blind_vote",
      "input": {
        "candidates_list": ["mem_opc_2026_01", "mem_opc_2026_05", "mem_opc_2026_12"]
      }
    },
    {
      "id": "node_3_tally_votes",
      "command": "poll_tally_votes",
      "input": {
        "poll_id": "POLL_2026_08"
      }
    },
    {
      "id": "node_4_trigger_payout_dag_08",
      "command": "trigger_sub_dag",
      "input": {
        "sub_dag_id": "dag_sop_08_fund_allocation",
        "variables": {
          "reward_type": "WEEKLY_COMMUNITY_POLL",
          "member_id": "{{nodes.node_3_tally_votes.output.winner_id}}",
          "group_name": "{{meeting_group}}",
          "week": "{{nodes.node_3_tally_votes.output.formatted_week}}"
        }
      }
    }
  ]
}
