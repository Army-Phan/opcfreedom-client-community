{
  "id": "dag_sop_17_it_customization_handover",
  "name": "SOP-17: Quy trình Quản lý Ticket & Bàn giao IT Customization May Đo",
  "description": "Tự động tiếp nhận yêu cầu may đo phần mềm, báo giá, đặt cọc 50%, phân task cho Dev/Mentor và thu 50% còn lại khi bàn giao",
  "variables": {
    "member_id": "mem_opc_2026_01",
    "description": "Nâng cấp tính năng tự động xuất báo cáo PDF tài chính",
    "github_repo_url": "https://github.com/opcfreedom/tenant-custom-module-sample"
  },
  "nodes": [
    {
      "id": "node_0_verify_member_status",
      "command": "member_verify_status",
      "input": {
        "member_id": "{{member_id}}"
      }
    },
    {
      "id": "node_0b_check_membership",
      "command": "evaluate_condition",
      "input": {
        "expression": "{{nodes.node_0_verify_member_status.output.is_active}} == true"
      },
      "branches": {
        "true": "node_0c_get_vps_details",
        "false": "node_0d_reject_inactive_member"
      }
    },
    {
      "id": "node_0c_get_vps_details",
      "command": "vps_get_details",
      "input": {
        "member_id": "{{member_id}}"
      },
      "next": "node_0e_check_github_linked"
    },
    {
      "id": "node_0d_reject_inactive_member",
      "command": "chat_send_message",
      "input": {
        "channel": "telegram",
        "recipient_id": "{{member_id}}",
        "text": "⚠️ Từ chối dịch vụ: Tài khoản thành viên của Anh/Chị không ở trạng thái hoạt động (ACTIVE). Vui lòng hoàn tất phí thành viên trước khi yêu cầu may đo."
      },
      "next": "END"
    },
    {
      "id": "node_0e_check_github_linked",
      "command": "evaluate_condition",
      "input": {
        "expression": "'{{nodes.node_0c_get_vps_details.output.github_repo_url}}' != ''"
      },
      "branches": {
        "true": "node_1_receive_ticket",
        "false": "node_0f_request_github_access"
      }
    },
    {
      "id": "node_0f_request_github_access",
      "command": "chat_send_message",
      "input": {
        "channel": "telegram",
        "recipient_id": "{{member_id}}",
        "text": "⚠️ Dự án của Anh/Chị trên VPS chưa liên kết mã nguồn GitHub.\nVui lòng thực hiện:\n1. Phân quyền (Write access) cho tài khoản GitHub: tadaup.com@gmail.com\n2. Gửi link GitHub repo cho BQT duyệt kết nối."
      },
      "next": "node_0g_pause_for_github_link"
    },
    {
      "id": "node_0g_pause_for_github_link",
      "command": "vps_test_and_link_github",
      "input": {
        "member_id": "{{member_id}}",
        "github_repo_url": "{{github_repo_url}}"
      },
      "next": "node_1_receive_ticket"
    },
    {
      "id": "node_1_receive_ticket",
      "command": "ticket_receive_request",
      "input": {
        "user_id": "{{member_id}}",
        "description": "{{description}}"
      },
      "next": "node_2_estimate_scope"
    },
    {
      "id": "node_2_estimate_scope",
      "command": "ai_estimate_scope_and_fee",
      "input": {
        "complexity_level": "medium",
        "estimated_hours": 16,
        "base_rate_per_hour": 250000,
        "github_repo_url": "{{nodes.node_0c_get_vps_details.output.github_repo_url}}",
        "ticket_id": "{{nodes.node_1_receive_ticket.output.ticket_id}}"
      },
      "next": "node_2a_publish_job_pool"
    },
    {
      "id": "node_2a_publish_job_pool",
      "command": "chat_send_message",
      "input": {
        "channel": "telegram",
        "recipient_id": "group_it_dev_pool",
        "text": "📢 JOB MỚI ĐÃ ĐƯỢC ĐĂNG!\n- Ticket ID: {{nodes.node_1_receive_ticket.output.ticket_id}}\n- Yêu cầu: {{description}}\n- Đánh giá AI: {{nodes.node_2_estimate_scope.output.estimated_hours}} giờ tối đa.\n- Đơn giá: 250,000 VND/giờ.\n👉 Các Dev dùng lệnh `/ticket bid {{nodes.node_1_receive_ticket.output.ticket_id}} <số_giờ> <đơn_giá> <tin_nhắn>` để đấu thầu."
      },
      "next": "node_2b_pause_for_bid_approval"
    },
    {
      "id": "node_2b_pause_for_bid_approval",
      "command": "ticket_wait_for_bid_approval",
      "input": {
        "ticket_id": "{{nodes.node_1_receive_ticket.output.ticket_id}}"
      },
      "next": "node_3_generate_deposit_qr"
    },
    {
      "id": "node_3_generate_deposit_qr",
      "command": "payment_generate_qr",
      "input": {
        "amount": "{{nodes.node_2b_pause_for_bid_approval.output.deposit_amount}}",
        "member_id": "{{member_id}}",
        "resource_sku": "SKU_CUSTOMIZATION_DEPOSIT_50",
        "ticket_id": "{{nodes.node_1_receive_ticket.output.ticket_id}}"
      },
      "next": "node_4_check_deposit_status"
    },
    {
      "id": "node_4_check_deposit_status",
      "command": "payment_wait_for_deposit",
      "input": {
        "ticket_id": "{{nodes.node_1_receive_ticket.output.ticket_id}}"
      },
      "next": "node_5_assign_dev_handover"
    },
    {
      "id": "node_5_assign_dev_handover",
      "command": "task_assign_dev_private_channel",
      "input": {
        "ticket_id": "{{nodes.node_1_receive_ticket.output.ticket_id}}",
        "dev_id": "{{nodes.node_2b_pause_for_bid_approval.output.assigned_dev_id}}"
      },
      "next": "node_7_verify_delivery_tests"
    },
    {
      "id": "node_7_verify_delivery_tests",
      "command": "auto_run_sandbox_tests",
      "input": {
        "ticket_id": "{{nodes.node_1_receive_ticket.output.ticket_id}}"
      },
      "next": "node_8_final_payment_and_close"
    },
    {
      "id": "node_8_final_payment_and_close",
      "command": "payment_collect_remaining_50",
      "input": {
        "amount": "{{nodes.node_2b_pause_for_bid_approval.output.deposit_amount}}",
        "ticket_id": "{{nodes.node_1_receive_ticket.output.ticket_id}}"
      },
      "next": "node_9_split_revenue_60_40"
    },
    {
      "id": "node_9_split_revenue_60_40",
      "command": "finance_revenue_split_60_40",
      "input": {
        "ticket_id": "{{nodes.node_1_receive_ticket.output.ticket_id}}"
      },
      "next": "END"
    }
  ]
}
