{
  "id": "dag_sop_05_resource_purchase",
  "name": "SOP-05: Quy trình Mua Tài nguyên Sỉ qua Chatbot Nội bộ",
  "description": "Xác thực ID thành viên Active, tạo VietQR thanh toán động và tự động cấp mã Key ngay khi Webhook báo tiền về",
  "nodes": [
    {
      "id": "node_3_generate_qr",
      "command": "payment_generate_qr",
      "input": {
        "amount": "{{amount}}",
        "member_id": "{{member_id}}",
        "resource_sku": "{{resource_sku}}"
      },
      "next": "node_5_listen_webhook"
    },
    {
      "id": "node_5_listen_webhook",
      "command": "webhook_listen_payment",
      "input": {
        "transaction_code": "{{nodes.node_3_generate_qr.output.transaction_code}}"
      },
      "next": "node_5b_check_vps"
    },
    {
      "id": "node_5b_check_vps",
      "command": "evaluate_condition",
      "input": {
        "expression": "'{{resource_sku}}' == 'SKU_SERVER_12M'"
      },
      "branches": {
        "true": "node_7_trigger_vps_provision",
        "false": "node_6_deliver_resource_key"
      }
    },
    {
      "id": "node_6_deliver_resource_key",
      "command": "resource_deliver_key",
      "input": {
        "member_id": "{{member_id}}",
        "resource_sku": "{{resource_sku}}"
      }
    },
    {
      "id": "node_7_trigger_vps_provision",
      "command": "trigger_sub_dag",
      "input": {
        "member_id": "{{member_id}}",
        "sub_dag_id": "dag_sop_06_trumvps_provision",
        "variables": {
          "specs": "4vCPU_8GB_RAM_100GB_NVMe",
          "os_type": "Ubuntu_22_04_Desktop_AI_Docker",
          "order_id": "{{nodes.node_3_generate_qr.output.transaction_code}}"
        }
      }
    }
  ]
}
