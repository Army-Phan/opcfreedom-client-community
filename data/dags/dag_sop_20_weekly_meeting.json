{
  "id": "dag_sop_20_weekly_meeting",
  "name": "SOP-20: Quy trình Vận hành Họp Tuần Sinh hoạt Cộng đồng 1 Năm (52 Tuần)",
  "description": "Điều phối tự động 52 tuần họp sinh hoạt: gửi thông báo Zoom/Meet 24h, kiểm tra nộp 3 vấn đề điểm danh Zero-Touch, tự động điều phối phiên thảo luận trực tiếp trên MTB (Zero-Human-Host), tiếp nhận tối đa 3 góp ý/vấn đề, chấm điểm 3x3 trao thưởng Quỹ 20% qua DAG-13/DAG-08 và bàn giao DAG-16 cuối năm",
  "entry_points": [
    "FROM_DAG_04",
    "FROM_DAG_16_RENEW",
    "FAST_TRACK_DIRECT"
  ],
  "trigger": {
    "type": "CRON",
    "expression": "0 0 * * *"
  },
  "nodes": [
    {
      "id": "node_1_register_weekly_roster",
      "command": "meeting_register_member",
      "input": {
        "member_id": "{{member_id}}",
        "member_group": "{{member_group}}",
        "entry_source": "{{entry_source}}",
        "valid_weeks": 52
      },
      "next": "node_2_schedule_weekly_reminder"
    },
    {
      "id": "node_2_schedule_weekly_reminder",
      "command": "trigger_sub_dag",
      "input": {
        "sub_dag_id": "dag_sop_18_push_communication",
        "variables": {
          "campaign_type": "WEEKLY_MEETING_REMINDER_24H",
          "member_group": "{{member_group}}",
          "meeting_agenda": "Giải 3 Vấn Đề Vận Hành & 3 Góp Ý Đổi Mới"
        }
      },
      "next": "node_3_attendance_audit"
    },
    {
      "id": "node_3_attendance_audit",
      "command": "weekly_attendance_audit",
      "input": {
        "member_id": "{{member_id}}",
        "member_group": "{{member_group}}",
        "current_week": "{{current_week}}"
      },
      "next": "node_4_branch_attendance"
    },
    {
      "id": "node_4_branch_attendance",
      "command": "evaluate_condition",
      "input": {
        "expression": "{{nodes.node_3_attendance_audit.output.consecutive_absent}} >= 2"
      },
      "branches": {
        "true": "node_5_handle_absence",
        "false": "node_6_live_meeting_moderator"
      }
    },
    {
      "id": "node_5_handle_absence",
      "command": "meeting_absence_remediation",
      "input": {
        "member_id": "{{member_id}}",
        "consecutive_absent": "{{nodes.node_3_attendance_audit.output.consecutive_absent}}"
      },
      "next": "node_5b_branch_lock"
    },
    {
      "id": "node_5b_branch_lock",
      "command": "evaluate_condition",
      "input": {
        "expression": "{{nodes.node_3_attendance_audit.output.consecutive_absent}} >= 3"
      },
      "branches": {
        "true": "node_5c_trigger_dag14_lock",
        "false": "node_6_live_meeting_moderator"
      }
    },
    {
      "id": "node_5c_trigger_dag14_lock",
      "command": "trigger_sub_dag",
      "input": {
        "sub_dag_id": "dag_sop_14_autolock_unlock",
        "variables": {
          "member_id": "{{member_id}}",
          "lock_reason": "VẮNG_HỌP_3_TUẦN_LIÊN_TIẾP"
        }
      },
      "next": "node_7_check_annual_cycle"
    },
    {
      "id": "node_6_live_meeting_moderator",
      "command": "live_meeting_moderate_cycle",
      "input": {
        "member_group": "{{member_group}}",
        "current_week": "{{current_week}}"
      },
      "next": "node_6b_trigger_dag13_poll"
    },
    {
      "id": "node_6b_trigger_dag13_poll",
      "command": "trigger_sub_dag",
      "input": {
        "sub_dag_id": "dag_sop_13_contribution_poll",
        "variables": {
          "meeting_group": "{{member_group}}",
          "week_number": "{{current_week}}"
        }
      },
      "next": "node_7_check_annual_cycle"
    },
    {
      "id": "node_7_check_annual_cycle",
      "command": "evaluate_condition",
      "input": {
        "expression": "{{nodes.node_3_attendance_audit.output.accumulated_weeks}} >= 52"
      },
      "branches": {
        "true": "node_8_handover_to_dag16",
        "false": "node_9_next_week_wait"
      }
    },
    {
      "id": "node_8_handover_to_dag16",
      "command": "trigger_sub_dag",
      "input": {
        "sub_dag_id": "dag_sop_16_exit_mna_renewal",
        "variables": {
          "member_id": "{{member_id}}",
          "annual_attendance_rate": "{{nodes.node_3_attendance_audit.output.attendance_rate}}"
        }
      },
      "next": "END"
    },
    {
      "id": "node_9_next_week_wait",
      "command": "weekly_cycle_standby",
      "input": {
        "member_id": "{{member_id}}",
        "next_week": "{{nodes.node_3_attendance_audit.output.next_week}}"
      },
      "next": "END"
    }
  ]
}