{
  "id": "dag_sop_09_financial_cic_audit",
  "name": "SOP-09: Quy trình Thu thập Dữ liệu Pitchdeck, Finance Model & CIC",
  "description": "Thu thập báo cáo tín dụng CIC, thẩm định tính khả thi mô hình tài chính và mã hóa đóng gói Data Folder gọi vốn",
  "nodes": [
    {
      "id": "node_1_check_nationality",
      "command": "credit_check_nationality",
      "input": {
        "member_id": "{{member_id}}"
      },
      "next": "node_2_branch_nationality"
    },
    {
      "id": "node_2_branch_nationality",
      "command": "evaluate_condition",
      "input": {
        "expression": "'{{nodes.node_1_check_nationality.output.nationality}}' == 'VN'"
      },
      "branches": {
        "true": "node_3_collect_cic",
        "false": "node_4_collect_project_docs"
      }
    },
    {
      "id": "node_3_collect_cic",
      "command": "credit_collect_cic_md",
      "input": {
        "member_id": "{{member_id}}",
        "nationality": "{{nodes.node_1_check_nationality.output.nationality}}"
      },
      "next": "node_4_collect_project_docs"
    },
    {
      "id": "node_4_collect_project_docs",
      "command": "credit_collect_project_docs_md",
      "input": {
        "member_id": "{{member_id}}"
      },
      "next": "node_5_build_encrypted_data_folder"
    },
    {
      "id": "node_5_build_encrypted_data_folder",
      "command": "build_data_folder",
      "input": {
        "member_id": "{{member_id}}",
        "pitchdeck": "{{nodes.node_4_collect_project_docs.output.pitchdeck_file}}",
        "finance_model": "{{nodes.node_4_collect_project_docs.output.finance_model_file}}",
        "business_plan": "{{nodes.node_4_collect_project_docs.output.business_plan_file}}"
      },
      "next": "node_6_trigger_dag10"
    },
    {
      "id": "node_6_trigger_dag10",
      "command": "trigger_sub_dag",
      "input": {
        "sub_dag_id": "dag_sop_10_partner_tracking",
        "member_id": "{{member_id}}",
        "variables": {
          "company_name": "{{nodes.node_4_collect_project_docs.output.current_organization}}"
        }
      }
    }
  ]
}
