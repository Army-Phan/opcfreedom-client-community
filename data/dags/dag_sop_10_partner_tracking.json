{
  "id": "dag_sop_10_partner_tracking",
  "name": "SOP-10: Quy trình Follow Đối tác Từng Hồ sơ & Đấu Thầu Vốn",
  "description": "Đăng hồ sơ gọi vốn lên pool đối tác tài chính, thu hoa hồng 5% qua VietQR, và đếm ngược thời gian giải ngân quá hạn để hoàn tiền",
  "trigger": {
    "type": "EVENT",
    "event": "capital_folder_ready"
  },
  "nodes": [
    {
      "id": "node_1_publish_deal",
      "command": "capital_publish_deal",
      "input": {
        "member_id": "{{member_id}}",
        "data_folder_url": "{{encrypted_data_folder_url}}"
      },
      "next": "node_2_wait_for_partner_bid"
    },
    {
      "id": "node_2_wait_for_partner_bid",
      "command": "capital_wait_for_partner_bid",
      "input": {
        "deal_id": "{{nodes.node_1_publish_deal.output.deal_id}}"
      },
      "next": "node_3_generate_commission_qr"
    },
    {
      "id": "node_3_generate_commission_qr",
      "command": "payment_generate_qr",
      "input": {
        "amount": "{{nodes.node_2_wait_for_partner_bid.output.commission_amount}}",
        "member_id": "{{member_id}}",
        "resource_sku": "SKU_FINANCE_COMMISSION_5"
      },
      "next": "node_4_wait_for_commission_payment"
    },
    {
      "id": "node_4_wait_for_commission_payment",
      "command": "webhook_listen_payment",
      "input": {
        "transaction_code": "{{nodes.node_3_generate_commission_qr.output.transaction_code}}"
      },
      "next": "node_5_start_disbursement_countdown"
    },
    {
      "id": "node_5_start_disbursement_countdown",
      "command": "capital_wait_for_disbursement_deadline",
      "input": {
        "deal_id": "{{nodes.node_1_publish_deal.output.deal_id}}",
        "deadline_days": "{{nodes.node_2_wait_for_partner_bid.output.expected_days}}"
      },
      "next": "node_6_evaluate_disbursement_status"
    },
    {
      "id": "node_6_evaluate_disbursement_status",
      "command": "evaluate_condition",
      "input": {
        "expression": "{{nodes.node_5_start_disbursement_countdown.output.is_disbursed}} == true"
      },
      "branches": {
        "true": "node_7_complete_deal",
        "false": "node_8_trigger_refund_flow"
      }
    },
    {
      "id": "node_7_complete_deal",
      "command": "capital_close_deal_success",
      "input": {
        "deal_id": "{{nodes.node_1_publish_deal.output.deal_id}}"
      },
      "next": "END"
    },
    {
      "id": "node_8_trigger_refund_flow",
      "command": "capital_execute_deal_failed_refund",
      "input": {
        "deal_id": "{{nodes.node_1_publish_deal.output.deal_id}}"
      },
      "next": "END"
    }
  ]
}
