{
  "id": "dag_sop_14_autolock_unlock",
  "name": "SOP-14: Quy trình Xử lý Auto-Lock & Khôi phục Tài khoản Thành viên",
  "description": "Tự động gửi thông báo nhắc phí trước 15, 7, 3 ngày; Auto-Lock ngắt Token lúc 00:00 Tháng 6 và tự động Unlock trong 5 phút khi tiền về",
  "status": "ACTIVE",
  "trigger": {
    "type": "CRON",
    "expression": "0 0 1 * *"
  },
  "nodes": [
    {
      "id": "node_1_send_reminders",
      "command": "bot_send_reminders_15_7_3d",
      "input": {
        "member_id": "{{member_id}}",
        "due_days": 3
      }
    },
    {
      "id": "node_2_check_payment_status",
      "command": "member_check_payment_due",
      "input": {
        "member_id": "{{member_id}}"
      }
    },
    {
      "id": "node_3_evaluate_autolock",
      "command": "evaluate_condition",
      "input": {
        "expression": "{{nodes.node_2_check_payment_status.output.is_paid}} == true"
      },
      "branches": {
        "true": "node_4_unlock_in_5mins",
        "false": "node_5_execute_autolock"
      }
    },
    {
      "id": "node_4_unlock_in_5mins",
      "command": "member_unlock_5min",
      "input": {
        "member_id": "{{member_id}}",
        "payment_receipt": "{{variables.payment_receipt}}"
      },
      "next": "END"
    },
    {
      "id": "node_5_execute_autolock",
      "command": "member_auto_lock",
      "input": {
        "member_id": "{{member_id}}"
      },
      "next": "END"
    }
  ]
}
