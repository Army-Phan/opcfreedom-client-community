{
  "id": "dag_sop_18_push_communication",
  "name": "SOP-18: Quy Trình Push Tin Nhắn Truyền Thông Đa Kênh & Chống Spam",
  "description": "Tự động phân loại đối tượng (Chưa định danh SĐT, Đã định danh SĐT, Thành viên tự do), định tuyến kênh truyền thông (Email, Telegram, Zalo, FB), hàng chờ Smart Queue và khống chế tần suất gửi.",
  "parameters": {
    "frequency_cap_per_day": 1,
    "min_delay_seconds": 15,
    "max_delay_seconds": 45,
    "human_typing_delay": true
  },
  "nodes": [
    {
      "id": "node_0_select_content",
      "command": "cme_verify_campaign_content",
      "input": {
        "content_ids": [
          "campaign_nurture_membership_2026",
          "campaign_objection_handling_2026",
          "campaign_renewal_freelance_2026"
        ]
      },
      "next": "node_1_filter_audience"
    },
    {
      "id": "node_1_filter_audience",
      "command": "crm_filter_push_audience",
      "input": {
        "campaign_id": "campaign_nurture_membership_2026",
        "skip_unidentified_no_contact": true
      }
    },
    {
      "id": "node_2a_route_unidentified",
      "command": "push_route_unidentified_leads",
      "input": {
        "audience_list": "{{nodes.node_1_filter_audience.output.unidentified_leads}}",
        "channel_priority": ["facebook_personal", "zalo", "telegram", "email"],
        "content_object": "{{nodes.node_0_select_content.output.verified_contents.campaign_nurture_membership_2026}}"
      }
    },
    {
      "id": "node_2b_route_identified",
      "command": "push_route_identified_fallback",
      "input": {
        "audience_list": "{{nodes.node_1_filter_audience.output.identified_leads}}",
        "channel_priority": ["telegram", "zalo", "facebook_personal", "email"],
        "content_object": "{{nodes.node_0_select_content.output.verified_contents.campaign_objection_handling_2026}}"
      }
    },
    {
      "id": "node_2c_route_members",
      "command": "push_route_membership_channel",
      "input": {
        "audience_list": "{{nodes.node_1_filter_audience.output.membership_users}}",
        "message_type": "campaign_nurture_weekly",
        "content_object": "{{nodes.node_0_select_content.output.verified_contents.campaign_renewal_freelance_2026}}"
      }
    },
    {
      "id": "node_3_merge_queues",
      "command": "push_merge_message_queues",
      "input": {
        "queues": [
          "{{nodes.node_2a_route_unidentified.output.queue}}",
          "{{nodes.node_2b_route_identified.output.queue}}",
          "{{nodes.node_2c_route_members.output.queue}}"
        ]
      }
    },
    {
      "id": "node_4_smart_queue_dispatch",
      "command": "push_smart_queue_dispatch",
      "input": {
        "queue_list": "{{nodes.node_3_merge_queues.output.merged_queue}}",
        "frequency_cap": 1,
        "human_typing_delay": true,
        "fb_mode": "personal_account_browser",
        "fast_mode": "{{variables.fast_mode}}"
      }
    }
  ]
}
