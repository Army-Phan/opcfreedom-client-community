# ==============================================================================
# OPC FREEDOM COMMUNITY CLIENT NODE - CONFIGURATION TEMPLATE
# ==============================================================================

# 1. Kết Nối Về Core HQ (Quản trị bản quyền & Chia sẻ Catalog Chợ)
MASTER_CORE_URL=http://localhost:3000

# 2. Bản Quyền & Định Danh Máy Trạm (Mặc định được tặng key cộng đồng miễn phí)
OPC_LICENSE_KEY=OPC-COMMUNITY-FREE-2026
CUSTOMER_NAME=OPC Community Node 01

# 3. Cổng Dịch Vụ Cục Bộ
DASHBOARD_PORT=3001
NOVNC_PORT=6080
WEB_STUDIO_PORT=5173
AGENT_PORT=3002
BOT_PORT=3003

# 4. Bảo Mật Cloud Desktop (noVNC)
# Để trống nếu không muốn đặt pass. Điền pass (ví dụ: MySecurePass123) để khóa màn hình noVNC:
VNC_PASSWORD=
VNC_RESOLUTION=1600x900

# 5. Telegram Bot Riêng (Điều khiển máy trạm từ xa - Tùy chọn)
MASTER_TELEGRAM_BOT_TOKEN=
MASTER_TELEGRAM_ADMIN_ID=
